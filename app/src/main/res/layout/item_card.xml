<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp" android:layout_height="198dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
    android:background="@drawable/card_bg" android:clickable="true" android:focusable="true" android:foreground="@drawable/card_focus">
    <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop"/>
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/card_scrim" android:ellipsize="end" android:maxLines="2" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="22dp" android:paddingBottom="8dp" android:textColor="@color/text" android:textSize="13sp"/>
</FrameLayout>
