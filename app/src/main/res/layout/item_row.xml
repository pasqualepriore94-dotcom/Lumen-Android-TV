<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false"
    android:orientation="vertical" android:paddingTop="10dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="56dp"
        android:fontFamily="sans-serif-medium" android:textColor="@color/text" android:textSize="19sp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:paddingTop="12dp" android:paddingBottom="14dp"/>
</LinearLayout>
