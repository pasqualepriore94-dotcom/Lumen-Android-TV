<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:text="Guida TV" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="horizontal">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="440dp" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="40dp" android:paddingEnd="8dp" android:paddingBottom="24dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/programmes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clipToPadding="false" android:focusable="false" android:paddingStart="16dp" android:paddingEnd="48dp" android:paddingBottom="24dp"/>
    </LinearLayout>
</LinearLayout>
