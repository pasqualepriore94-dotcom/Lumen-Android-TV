<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:paddingStart="220dp" android:paddingEnd="220dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lumen" android:textColor="@color/accent" android:textSize="42sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/email" style="@style/LumenField" android:hint="Email" android:inputType="textEmailAddress" android:imeOptions="actionNext"/>
    <EditText android:id="@+id/password" style="@style/LumenField" android:hint="Password" android:inputType="textPassword" android:imeOptions="actionDone"/>
    <Button android:id="@+id/signIn" style="@style/LumenButton" android:layout_marginEnd="0dp" android:text="Accedi"/>
    <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/muted" android:textSize="16sp"/>
</LinearLayout>
