<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="48dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Impostazioni" android:textColor="@color/text" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indirizzo della playlist (.m3u), facoltativo" android:textColor="@color/muted" android:textSize="16sp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/playlistUrl" style="@style/LumenField" android:hint="https://…" android:inputType="textUri" android:imeOptions="actionDone"/>
    <TextView android:id="@+id/playlistStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-6dp" android:layout_marginBottom="14dp" android:textColor="@color/muted" android:textSize="14sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Guida TV (XMLTV), facoltativa: se vuota si usa quella indicata nella playlist" android:textColor="@color/muted" android:textSize="16sp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/epgUrl" style="@style/LumenField" android:hint="https://…/guida.xml.gz" android:inputType="textUri" android:imeOptions="actionDone"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/save" style="@style/LumenButton" android:text="Salva"/>
        <Button android:id="@+id/fromPhone" style="@style/LumenButton" android:text="Inserisci dal telefono"/>
        <Button android:id="@+id/checkUpdate" style="@style/LumenButton" android:text="Cerca aggiornamenti"/>
        <Button android:id="@+id/signOut" style="@style/LumenButton" android:text="Esci dall'account"/>
    </LinearLayout>
    <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/muted" android:textSize="16sp"/>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="@color/muted" android:textSize="13sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Questo prodotto usa l'API di TMDB ma non è approvato né certificato da TMDB." android:textColor="@color/muted" android:textSize="13sp"/>
</LinearLayout>
